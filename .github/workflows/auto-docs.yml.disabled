name: Auto Docs

# DISABLED: renamed to *.disabled so GitHub Actions won't pick it up.
# docs/ currently has no mkdocs.yml and no markdown content (assets only),
# so `mkdocs build --strict` has nothing to build. Rename back to
# `auto-docs.yml` once real docs content + mkdocs.yml are added.
#
# Deploy docs to GitHub Pages on every push to production.
# On PRs to dev or production, only build (validate) — do not deploy.
on:
  push:
    branches:
      - production

  pull_request:
    branches:
      - dev
      - production

jobs:
  # ── 1. Build docs (runs on every PR to validate the docs compile) ────────
  build-docs:
    name: Build Documentation
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v5

      - name: Setup Python
        uses: actions/setup-python@v6
        with:
          python-version: "3.11"
          cache: pip

      - name: Install docs dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r .github/requirements/docs.txt

      - name: Build docs (validate only)
        run: mkdocs build --strict

  # ── 2. Deploy docs to GitHub Pages (production merges only) ─────────────
  deploy-docs:
    name: Deploy Documentation
    needs: build-docs
    runs-on: ubuntu-latest

    # Only deploy when a commit lands on production, not on PRs.
    if: github.event_name == 'push' && github.ref == 'refs/heads/production'

    permissions:
      contents: write   # required for gh-deploy to push to gh-pages branch

    steps:
      - name: Checkout
        uses: actions/checkout@v5
        with:
          fetch-depth: 0   # full history needed for mkdocs git-revision-date plugins

      - name: Setup Python
        uses: actions/setup-python@v6
        with:
          python-version: "3.11"
          cache: pip

      - name: Install docs dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r .github/requirements/docs.txt

      - name: Configure Git for gh-deploy
        run: |
          git config user.name  "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"

      - name: Deploy docs to GitHub Pages
        run: mkdocs gh-deploy --force
